App(
    appid="flipper_wifi_census",
    name="WiFi Census",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="wc_app",
    stack_size=4 * 1024,
    fap_category="GPIO",
    fap_icon="icons/icon.icon",
    fap_version="0.1.0",  # x-release-please-version
    fap_author="Endika",
    fap_description="Passive Wi-Fi device census over an ESP32 Marauder dev board: count and type nearby devices, save each scan, and compare captures across locations. Local-only.",
    requires=["gui", "storage"],
    sources=[
        "main.c",
        "src/domain/wc_version_info.c",
        "src/domain/wc_observation.c",
        "src/domain/wc_signature.c",
        "src/domain/wc_census.c",
        "src/domain/wc_capture_codec.c",
    ],
)
